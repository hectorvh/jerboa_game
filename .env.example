# Copy to .env.local for development.
#
# Local Postgres (database name `jerboa`, Unix-socket peer auth as your OS user):
#   NEXT_PUBLIC_JERBOA_BACKEND=postgres
#   DATABASE_URL=postgresql:///jerboa?host=/var/run/postgresql
#
# DATABASE_URL has no NEXT_PUBLIC_ prefix on purpose: only the Next.js server
# connects to Postgres. Apply the schema with `pnpm db:apply`.
#
# Cloud Supabase — both names carry NEXT_PUBLIC_ because the browser talks to
# Supabase directly. Safe only because every table has RLS scoped to auth.uid().
# The secret key (sb_secret_...) must NOT live in this file.

NEXT_PUBLIC_JERBOA_BACKEND=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Used when NEXT_PUBLIC_JERBOA_BACKEND=postgres.
DATABASE_URL=

# Force in-memory storage even in a production build.
# NEXT_PUBLIC_JERBOA_BACKEND=memory
