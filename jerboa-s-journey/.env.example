# All of these are optional. With none of them set, `pnpm dev` runs in prototype
# mode: answers are kept in memory and lost on reload, so the app runs with no
# Supabase project and no Netlify deploy. Copy this file to .env.local only when
# you are ready to connect the real database.
#
# Both Supabase names carry NEXT_PUBLIC_ on purpose: the browser talks to
# Supabase directly, so these values are compiled into the client bundle and are
# visible to anyone who views source. That is safe here — and only here —
# because every table has Row Level Security scoped to the caller's auth.uid(),
# so the publishable key grants nothing without an anonymous sign-in, and a
# signed-in participant can still only touch their own rows.
#
# The secret key (sb_secret_...) must NOT live in this file. It bypasses RLS,
# and there is no server-side code left to use it. Keep it in a password manager
# for administrative access only.

# Project URL, e.g. https://abcdefghijklm.supabase.co
# Setting this and the key below switches the app to the real database.
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key from Settings > API Keys (sb_publishable_...).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Set to `memory` to force prototype mode even in a production build — useful
# for deploying a clickable prototype that deliberately stores nothing.
#
# Without it, a production build that is missing the two variables above fails
# fast instead of quietly accepting answers and discarding them.
# NEXT_PUBLIC_JERBOA_BACKEND=memory
